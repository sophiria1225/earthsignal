# Optional: AI explanation generation. Without it, the server returns a rule-based explanation.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional comma-separated HTTPS Mastodon instances (maximum 3).
MASTODON_INSTANCES="https://mastodon.social,https://mstdn.jp"

# Optional: use a Bluesky App Password when the public search endpoint rejects the server IP.
# Keep these values server-side only.
BLUESKY_IDENTIFIER=""
BLUESKY_APP_PASSWORD=""
